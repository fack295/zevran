---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<html lang="en">
  <head>
    <title>ZEVRAN - Order & Delivery Info</title>
    <meta name="description" content="How to order, payment methods, delivery time, and courier information for ZEVRAN leather goods." />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
  </head>
  <body class="bg-ivory text-espresso font-montserrat">
    <Header />
    <main class="max-w-4xl mx-auto p-12 space-y-6 fade-in">
      <section>
        <h1 class="font-cormorant text-3xl mb-4">How to Order</h1>
        <p>Order via WhatsApp or the order form on our website.</p>
      </section>
      <section>
        <h2 class="font-semibold">Payment Methods</h2>
        <ul class="list-disc list-inside">
          <li>Cash on Delivery (COD)</li>
          <li>Bank Transfer (details TBD)</li>
          <li>JazzCash (details TBD)</li>
          <li>Easypaisa (details TBD)</li>
        </ul>
      </section>
      <section>
        <h2 class="font-semibold">Delivery Time</h2>
        <p>[TBD]</p>
      </section>
      <section>
        <h2 class="font-semibold">Courier</h2>
        <p>[TBD]</p>
      </section>
    </main>
    <Footer />
  </body>
</html>
