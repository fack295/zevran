---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<!-- Verify against Pakistani consumer-protection rules before publishing -->
<html lang="en">
  <head>
    <title>ZEVRAN - Policies</title>
    <meta name="description" content="Return and Exchange policies for ZEVRAN leather goods." />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
  </head>
  <body class="bg-ivory text-espresso font-montserrat">
    <Header />
    <main class="max-w-4xl mx-auto p-12 space-y-6 fade-in">
      <h1 class="font-cormorant text-3xl mb-4">Return and Exchange Policy</h1>
      <section>
        <p>Exchange request within 3 days of receiving the product; unused, undamaged, original packaging.</p>
        <p>ZEVRAN covers delivery/exchange cost for confirmed manufacturing defect or wrong item; no change-of-mind returns.</p>
        <p>Unboxing video may be requested for damage claims; customized/monogrammed items non-returnable except where law requires.</p>
        <p>Refunds via original or agreed method.</p>
      </section>
    </main>
    <Footer />
  </body>
</html>
